{
  "name": "local-mcp-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable local MCP server with stdio and loopback Streamable HTTP transports",
  "license": "MIT",
  "engines": {"node": ">=24.14.0"},
  "scripts": {
    "start": "node src/main.mjs stdio examples/config.json",
    "http": "node src/main.mjs http examples/config.json",
    "demo:init": "node scripts/init-demo.mjs",
    "test": "node --test test/integration.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  }
}
